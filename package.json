{
  "name": "trinetra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/server.mjs",
    "dev": "node backend/server.mjs",
    "start:logger": "PORT=4174 LOG_TO_CONSOLE=true node backend/server.mjs",
    "start:prod": "NODE_ENV=production HOST=0.0.0.0 node backend/server.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "incubate": "node scripts/incubate-models.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:setup:interactive": "node scripts/setup-env.mjs --interactive",
    "env:check": "node scripts/validate-env.mjs",
    "mcps:check": "node scripts/check-mcps.mjs",
    "ci": "npm run check && npm test && npm run smoke"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  }
}
